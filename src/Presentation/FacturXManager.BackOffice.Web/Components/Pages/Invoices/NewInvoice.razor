@page "/invoices/new"
@using FacturXManager.BackOffice.Web.Features.Compliance
@using FacturXManager.BackOffice.Web.Features.Invoices.GenerateAndSubmitInvoice
@using FacturXManager.BackOffice.Web.Features.Invoices.GenerateInvoice
@using FacturXManager.BackOffice.Web.Features.Invoices.DownloadInvoicePdf
@using FacturXManager.BackOffice.Web.Features.Invoices.ImportFromJson
@using FacturXManager.BackOffice.Web.Features.Invoices.ViewModels
@inject ISender Sender
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Nouvelle facture — FacturX Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Générer une facture Factur-X</RadzenText>

@* ── Import JSON ── *@
<RadzenCard class="rz-mb-4">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenIcon Icon="upload_file" style="font-size: 1.5rem; color: var(--rz-primary)" />
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">Préremplir depuis un JSON</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" style="color: var(--rz-text-secondary-color)">
            Importez un fichier JSON au format <code>invoice</code> pour préremplir automatiquement le formulaire.
        </RadzenText>
        <RadzenUpload Accept=".json,application/json" Auto="false" Change="OnJsonFileSelectedAsync"
                      Disabled="_importBusy" ChooseText="Choisir un fichier JSON" />
        @if (_importBusy)
        {
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        }
    </RadzenStack>
</RadzenCard>

<RadzenCard class="rz-mb-4">
    <EditForm Model="@_form" OnValidSubmit="OnCertifyAsync">
        <DataAnnotationsValidator />

        @* ── Identité de la facture ── *@
        <RadzenFieldset Text="Facture" class="rz-mb-4">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Numéro *" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.Number" Name="Number" Placeholder="FA-2025-001" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _form.Number)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Date d'émission *" class="rz-w-100">
                        <RadzenDatePicker @bind-Value="_form.IssueDate" Name="IssueDate" DateFormat="dd/MM/yyyy" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Devise *" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.CurrencyCode" Name="CurrencyCode" Placeholder="EUR" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Profil *" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_form.Profile" Data="_profiles" Name="Profile" class="rz-w-100" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Nature de l'opération *" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_form.OperationNature" Data="_operationNatures" Name="OperationNature" class="rz-w-100" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Référence acheteur" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.BuyerReference" Placeholder="Optionnel" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="N° commande acheteur" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.PurchaseOrderReference" Placeholder="Optionnel" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        @* ── Vendeur ── *@
        <RadzenFieldset Text="Vendeur" class="rz-mb-4">
            <PartyFields Form="_form.Seller" />
        </RadzenFieldset>

        @* ── Acheteur ── *@
        <RadzenFieldset Text="Acheteur" class="rz-mb-4">
            <PartyFields Form="_form.Buyer" />
        </RadzenFieldset>

        @* ── Paiement ── *@
        <RadzenFieldset Text="Paiement" class="rz-mb-4">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Moyen de paiement *" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_form.Payment.MeansCode" Data="_paymentMeans"
                                        TextProperty="Label" ValueProperty="Value" class="rz-w-100" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Date d'échéance" class="rz-w-100">
                        <RadzenDatePicker @bind-Value="_form.Payment.DueDate" DateFormat="dd/MM/yyyy" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="IBAN" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.Payment.Iban" Placeholder="FR76…" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        @* ── Lignes ── *@
        <RadzenFieldset Text="Lignes de facture" class="rz-mb-4">
            @for (int i = 0; i < _form.Lines.Count; i++)
            {
                int index = i;
                <InvoiceLineFields Line="_form.Lines[index]" Index="index" OnRemove="RemoveLine" />
            }
            <RadzenButton Text="Ajouter une ligne" Icon="add" ButtonStyle="ButtonStyle.Light"
                          Click="AddLine" class="rz-mt-2" />
        </RadzenFieldset>

        @* ── Actions ── *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Certifier" Icon="verified"
                          ButtonStyle="ButtonStyle.Primary" IsBusy="_certifying" BusyText="Certification…" />
            <RadzenButton Text="Télécharger PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary"
                          IsBusy="_downloading" BusyText="Génération…"
                          Click="OnDownloadPdfAsync" Disabled="@(_certifying)" />
            <RadzenButton Text="Générer et déposer" Icon="cloud_upload" ButtonStyle="ButtonStyle.Warning"
                          IsBusy="_submitting" BusyText="Dépôt en cours…"
                          Click="OnGenerateAndSubmitClickAsync" Disabled="@(_certifying || _downloading)" />
        </RadzenStack>

        @* ── Champs dépôt (affichés quand on clique sur Générer et déposer) ── *@
        @if (_showSubmitFields)
        {
            <RadzenCard class="rz-mt-3" style="background: var(--rz-warning-lighter)">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Paramètres Chorus Pro</RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="SIRET destinataire *" class="rz-w-100">
                            <RadzenTextBox @bind-Value="_recipientSiret" Placeholder="12345678901234" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Service exécutant" class="rz-w-100">
                            <RadzenTextBox @bind-Value="_executingService" Placeholder="Optionnel" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3" class="rz-d-flex rz-align-items-end">
                        <RadzenButton Text="Confirmer le dépôt" Icon="send" ButtonStyle="ButtonStyle.Warning"
                                      IsBusy="_submitting" BusyText="Dépôt en cours…"
                                      Click="OnGenerateAndSubmitAsync" class="rz-w-100" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }
    </EditForm>
</RadzenCard>

@* ── Résultat de certification ── *@
@if (_certified is not null)
{
    <RadzenCard class="rz-mt-4">
        <RadzenText TextStyle="TextStyle.H6">Facture certifiée</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mt-2">
            <RadzenBadge Text="@_certified.InvoiceNumber" BadgeStyle="BadgeStyle.Primary" />
            <RadzenBadge Text="@_certified.Profile" BadgeStyle="BadgeStyle.Info" />
            <RadzenBadge Text="@($"Total TTC : {_certified.TotalWithVat:N2} €")" BadgeStyle="BadgeStyle.Success" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3">
            <RadzenButton Text="Télécharger le PDF certifié" Icon="picture_as_pdf"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="OnDownloadCertifiedPdfAsync" />
            <RadzenButton Text="Déposer sur Chorus Pro" Icon="cloud_upload"
                          ButtonStyle="ButtonStyle.Warning"
                          Click="NavigateToTransmission" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    private readonly InvoiceFormViewModel _form = new();
    private CertifiedInvoiceViewModel? _certified;
    private bool _certifying;
    private bool _downloading;
    private bool _submitting;
    private bool _showSubmitFields;
    private bool _importBusy;
    private string _recipientSiret = string.Empty;
    private string? _executingService;

    private static readonly string[] _profiles = ["EN16931", "Extended"];
    private static readonly string[] _operationNatures = ["Goods", "Services", "Mixed", "ConstructionWork"];

    private sealed record PaymentMean(string Label, string Value);

    private static readonly List<PaymentMean> _paymentMeans =
    [
        new ("Virement bancaire", "BankTransfer"),
        new ("Virement de débit", "DebitTransfer"),
        new ("Carte bancaire", "BankCard"),
        new ("Prélèvement bancaire", "DirectDebit"),
        new ("Virement SEPA", "SepaCreditTransfer"),
        new ("Prélèvement SEPA", "SepaDirectDebit"),
        new ("Compensation", "ClearingBetweenPartners"),
    ];

    private void AddLine() =>
        _form.Lines.Add(new InvoiceLineFormViewModel { Id = (_form.Lines.Count + 1).ToString() });

    private void RemoveLine(int index)
    {
        if (_form.Lines.Count > 1)
        {
            _form.Lines.RemoveAt(index);
        }
    }

    private async Task OnJsonFileSelectedAsync(UploadChangeEventArgs e)
    {
        IBrowserFile? file = e.Files?.FirstOrDefault();
        if (file is null)
        {
            return;
        }

        _importBusy = true;

        string? error = await InvoiceJsonImporter.TryApplyAsync(file, _form);

        _importBusy = false;

        if (error is not null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Import JSON échoué", error);
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Success, "Formulaire prérempli", "Les données du JSON ont été appliquées au formulaire.");
        }
    }


    private async Task OnCertifyAsync()
    {
        _certifying = true;
        _certified = null;

        Result<CertifiedInvoiceViewModel> result =
            await Sender.Send(new GenerateInvoiceRequest(_form));

        _certifying = false;

        if (result.IsFailure)
        {
            Notifications.Notify(NotificationSeverity.Error, "Échec de la certification", result.ErrorMessage);
            return;
        }

        _certified = result.Value;
        Notifications.Notify(NotificationSeverity.Success, "Facture certifiée", $"Facture {_certified!.InvoiceNumber} générée avec succès.");
    }

    private async Task OnDownloadPdfAsync()
    {
        _downloading = true;

        Result<GeneratedPdfViewModel> result =
            await Sender.Send(new DownloadInvoicePdfRequestFront(_form));

        _downloading = false;

        if (result.IsFailure)
        {
            Notifications.Notify(NotificationSeverity.Error, "Échec du téléchargement", result.ErrorMessage);
            return;
        }

        await TriggerDownload(result.Value!);
    }

    private async Task OnDownloadCertifiedPdfAsync()
    {
        if (_certified is null)
        {
            return;
        }

        byte[] bytes = Convert.FromBase64String(_certified.FacturXPdfBase64);
        await TriggerDownload(new GeneratedPdfViewModel($"facture-{_certified.InvoiceNumber}.pdf", bytes));
    }

    private void NavigateToTransmission() =>
        Navigation.NavigateTo("/transmissions/new");

    private void OnGenerateAndSubmitClickAsync() => _showSubmitFields = !_showSubmitFields;

    private async Task OnGenerateAndSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_recipientSiret))
        {
            Notifications.Notify(NotificationSeverity.Warning, "Champ manquant", "Le SIRET destinataire est obligatoire.");
            return;
        }

        _submitting = true;
        _showSubmitFields = false;

        Result<GenerateAndSubmitInvoiceViewModel> result = await Sender.Send(
            new GenerateAndSubmitInvoiceRequestFront(_form, _recipientSiret, "ChorusPro", _executingService));

        _submitting = false;

        if (result.IsFailure)
        {
            Notifications.Notify(NotificationSeverity.Error, "\u00c9chec du d\u00e9p\u00f4t", result.ErrorMessage);
            return;
        }

        GenerateAndSubmitInvoiceViewModel vm = result.Value!;
        Notifications.Notify(
            NotificationSeverity.Success,
            "D\u00e9p\u00f4t effectu\u00e9",
            $"Facture {vm.InvoiceNumber} d\u00e9pos\u00e9e. N\u00b0 Chorus Pro : {vm.ChannelDepositId}");
    }

    private async Task TriggerDownload(GeneratedPdfViewModel pdf) =>
        await Js.InvokeVoidAsync("downloadFile", pdf.FileName, "application/pdf", pdf.Content);
}
