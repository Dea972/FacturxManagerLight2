@page "/admin/credentials"
@using FacturXManager.BackOffice.Web.Features.Administration.ViewModels
@inject NotificationService Notifications
@inject IConfiguration Configuration

<PageTitle>Configuration credentials — FacturX Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">Configuration PISTE / Chorus Pro</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4" Style="color: var(--rz-text-secondary-color);">
    Ces paramètres sont stockés dans les secrets applicatifs du backend.
    Les valeurs déjà configurées apparaissent masquées — saisissez une nouvelle valeur uniquement pour la modifier.
</RadzenText>

<RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" class="rz-mb-4">
    ⚠️ Les secrets ne sont jamais transmis en clair dans les logs.
    La modification des credentials nécessite un redémarrage du backend pour être prise en compte.
</RadzenAlert>

<RadzenCard>
    <EditForm Model="@_form" OnValidSubmit="OnSaveAsync">
        <DataAnnotationsValidator />

        @* ── PISTE ── *@
        <RadzenFieldset Text="API PISTE (OAuth2)" class="rz-mb-4">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Client ID *" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.PisteClientId" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _form.PisteClientId)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Client Secret (laisser vide pour ne pas modifier)" class="rz-w-100">
                        <RadzenPassword @bind-Value="_form.PisteClientSecret"
                                        Placeholder="@(_hasExistingPisteSecret ? "••••••••" : "Nouveau secret")" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Environnement *" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_form.Environment" Data="_environments" class="rz-w-100" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        @* ── Chorus Pro ── *@
        <RadzenFieldset Text="Compte Technique Chorus Pro" class="rz-mb-4">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Id Compte Technique *" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.ChorusProAccountId" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _form.ChorusProAccountId)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Login *" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_form.ChorusProLogin" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _form.ChorusProLogin)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Mot de passe (laisser vide pour ne pas modifier)" class="rz-w-100">
                        <RadzenPassword @bind-Value="_form.ChorusProPassword"
                                        Placeholder="@(_hasExistingChorusPassword ? "••••••••" : "Nouveau mot de passe")" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" Icon="save"
                          ButtonStyle="ButtonStyle.Primary" IsBusy="_saving" BusyText="Enregistrement…" />
        </RadzenStack>
    </EditForm>
</RadzenCard>

@code {
    private readonly CredentialsFormViewModel _form = new();
    private bool _saving;

    // Indique si un secret est déjà configuré côté backend (pour afficher le placeholder masqué).
    private bool _hasExistingPisteSecret;
    private bool _hasExistingChorusPassword;

    private static readonly string[] _environments = ["Sandbox", "Production"];

    protected override void OnInitialized()
    {
        // Pré-remplissage des valeurs non-secrètes depuis la configuration injectée.
        // Les secrets ne sont jamais pré-remplis : seule leur présence est indiquée.
        _form.PisteClientId = Configuration["Piste:ClientId"] ?? string.Empty;
        _form.ChorusProAccountId = Configuration["ChorusPro:AccountId"] ?? string.Empty;
        _form.ChorusProLogin = Configuration["ChorusPro:Login"] ?? string.Empty;
        _form.Environment = Configuration["Piste:Environment"] ?? "Sandbox";

        _hasExistingPisteSecret = !string.IsNullOrEmpty(Configuration["Piste:ClientSecret"]);
        _hasExistingChorusPassword = !string.IsNullOrEmpty(Configuration["ChorusPro:Password"]);
    }

    private async Task OnSaveAsync()
    {
        _saving = true;
        await Task.Delay(300); // Simulation — un vrai endpoint /admin/credentials serait appelé ici.
        _saving = false;

        // Après enregistrement, masquer les secrets fraîchement saisis.
        if (!string.IsNullOrWhiteSpace(_form.PisteClientSecret))
        {
            _hasExistingPisteSecret = true;
            _form.PisteClientSecret = null;
        }

        if (!string.IsNullOrWhiteSpace(_form.ChorusProPassword))
        {
            _hasExistingChorusPassword = true;
            _form.ChorusProPassword = null;
        }

        Notifications.Notify(
            NotificationSeverity.Success,
            "Configuration enregistrée",
            "Les credentials seront pris en compte au prochain redémarrage du backend.");
    }
}
