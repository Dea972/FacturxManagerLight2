@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-px-3">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenIcon Icon="receipt_long" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">FacturX Manager</RadzenText>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Accueil" Icon="home" Path="/" />
            <RadzenPanelMenuItem Text="Factures" Icon="description" Path="/invoices" />
            <RadzenPanelMenuItem Text="Nouvelle facture" Icon="add_circle_outline" Path="/invoices/new" />
            <RadzenPanelMenuItem Text="Avoirs" Icon="undo" Path="/credit-notes/new" />
            <RadzenPanelMenuItem Text="Dépôt Chorus Pro" Icon="cloud_upload" Path="/transmissions/new" />
            <RadzenPanelMenuItem Text="Administration" Icon="settings" Path="/admin/credentials" />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
}
