@using FacturXManager.BackOffice.Web.Features.Invoices.ViewModels

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenFormField Text="Raison sociale *" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.Name" />
        </RadzenFormField>
        <ValidationMessage For="@(() => Form.Name)" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenFormField Text="Adresse ligne 1 *" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.AddressLine1" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenFormField Text="Adresse ligne 2" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.AddressLine2" Placeholder="Optionnel" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenFormField Text="Code postal *" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.PostalCode" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenFormField Text="Ville *" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.City" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="2">
        <RadzenFormField Text="Pays *" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.CountryCode" Placeholder="FR" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="5">
        <RadzenFormField Text="SIRET / N° légal" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.LegalRegistrationId" Placeholder="Optionnel" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="5">
        <RadzenFormField Text="N° TVA intracommunautaire" class="rz-w-100">
            <RadzenTextBox @bind-Value="Form.VatIdentifier" Placeholder="Optionnel" />
        </RadzenFormField>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter, EditorRequired]
    public PartyFormViewModel Form { get; set; } = default!;
}
