@using FacturXManager.BackOffice.Web.Features.Invoices.ViewModels

<RadzenCard class="rz-mb-2" Style="background: var(--rz-base-background-color);">
    <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
        <RadzenColumn Size="12" SizeMD="1">
            <RadzenFormField Text="N°" class="rz-w-100">
                <RadzenTextBox @bind-Value="Line.Id" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenFormField Text="Désignation *" class="rz-w-100">
                <RadzenTextBox @bind-Value="Line.Description" />
            </RadzenFormField>
            <ValidationMessage For="@(() => Line.Description)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="1">
            <RadzenFormField Text="Qté" class="rz-w-100">
                <RadzenNumeric @bind-Value="Line.Quantity" TValue="decimal" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">
            <RadzenFormField Text="P.U. HT" class="rz-w-100">
                <RadzenNumeric @bind-Value="Line.UnitNetPrice" TValue="decimal" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">
            <RadzenFormField Text="Cat. TVA" class="rz-w-100">
                <RadzenDropDown @bind-Value="Line.VatCategory" Data="_vatCategories" class="rz-w-100" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="1">
            <RadzenFormField Text="Taux TVA %" class="rz-w-100">
                <RadzenNumeric @bind-Value="Line.VatRate" TValue="decimal" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="1">
            <RadzenFormField Text="Unité" class="rz-w-100">
                <RadzenTextBox @bind-Value="Line.UnitCode" Placeholder="C62" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="1">
            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                          Click="@(() => OnRemove.InvokeAsync(Index))" />
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter, EditorRequired]
    public InvoiceLineFormViewModel Line { get; set; } = default!;

    [Parameter, EditorRequired]
    public int Index { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<int> OnRemove { get; set; }

    private static readonly string[] _vatCategories = ["Standard", "Zero", "Exempt", "ReverseCharge"];
}
